#!/bin/sh
#
# Pre-commit hook to run tests before allowing a commit.
#
# This script executes the project's test runner (test/bin/testrunner.ps1).
# If the tests fail, the commit is aborted.

echo "Running pre-commit tests..." >&2

# Check for PowerShell executable (pwsh preferred, fallback to powershell)
if command -v pwsh >/dev/null 2>&1; then
    PS_EXEC="pwsh"
elif command -v powershell >/dev/null 2>&1; then
    PS_EXEC="powershell"
else
    echo "Error: PowerShell not found. Cannot run tests." >&2
    exit 1
fi

# Define path to test runner relative to repo root
TEST_RUNNER="./test/bin/testrunner.ps1"

if [ ! -f "$TEST_RUNNER" ]; then
    echo "Error: Test runner not found at $TEST_RUNNER" >&2
    echo "Please ensure you are running git from the repository root." >&2
    exit 1
fi

# Run the tests
# We use -File to ensure proper execution
echo "Executing: $PS_EXEC -File $TEST_RUNNER" >&2
"$PS_EXEC" -File "$TEST_RUNNER"

# store exit code
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
    echo "" >&2
    echo "❌ Tests failed (Exit code: $EXIT_CODE). Commit aborted." >&2
    echo "Please fix the errors before committing." >&2
    echo "" >&2
    exit 1
fi

echo "✅ Tests passed. Proceeding with commit." >&2
exit 0

{
  "schemas": [
    {
      "id": "req-implemented",
      "message": "a requirement is implemented by at least one function, or names its wrapper in implemented_in (SC-073e, SC-073h)",
      "select": {
        "properties": {
          "type": {
            "const": "req"
          },
          "implemented_in": {
            "type": "string",
            "maxLength": 0
          }
        }
      },
      "validate": {
        "network_back": {
          "implements": {
            "contains": {
              "local": {
                "properties": {
                  "type": {
                    "const": "impl"
                  }
                }
              }
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "id": "req-tested",
      "message": "a requirement is tested by at least one test (SC-073e)",
      "select": {
        "properties": {
          "type": {
            "const": "req"
          }
        }
      },
      "validate": {
        "network_back": {
          "tests": {
            "contains": {
              "local": {
                "properties": {
                  "type": {
                    "const": "test"
                  }
                }
              }
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "id": "test-title-matchable",
      "message": "a test's title is its Pester path, which its result is matched on: a join splits on commas, and the testrunner turns backslashes in case names into slashes, so the title has neither (SC-073d)",
      "select": {
        "properties": {
          "type": {
            "const": "test"
          }
        }
      },
      "validate": {
        "local": {
          "properties": {
            "title": {
              "pattern": "^[^,\\\\]*$"
            }
          }
        }
      }
    },
    {
      "id": "result-links-its-test",
      "message": "a result from a traced Describe links the test it resulted from; an It renamed without its marker's title breaks the match (SC-073d). The traced Describes: in px-proxy.Tests.ps1 every Describe but \"Test safety\" and \"Removed upstream lookup\" (SC-073c, SC-073e); in scoop.Tests.ps1 every Describe but \"Get-ScoopHostRawUi\", and update-scoop.bat.Tests.ps1 (SC-073h)",
      "select": {
        "properties": {
          "type": {
            "const": "testcase"
          },
          "classname": {
            "pattern": "(^|/)(px-proxy|scoop|update-scoop\\.bat)\\.Tests\\.ps1$"
          },
          "case_name": {
            "pattern": "^(Get-PxDataDir|Get-PxConfigPath|Test-PxInstalled|Get-PxExecutable|Test-PxRunning|Get-PxUserConfigPath|Get-PxUserSetting|New-PxUserConfigTemplate|Write-PxConfig|Install-PxProxy|Stop-PxProxy|Start-PxProxy|Test-PxProxy|Script entry point|Invoke-PxProxyMain|Wait-ForKeyPress|Remove-PxProxy|Invoke-PxProxy|Get-ScoopUpdatableApp|Show-ScoopUpdatableApp|Read-ScoopMenuChoice|Wait-ScoopKeyPress|Update-ScoopApp|Invoke-ScoopUpdate|update-scoop\\.bat)\\."
          }
        },
        "required": [
          "classname",
          "case_name"
        ]
      },
      "validate": {
        "local": {
          "properties": {
            "result_of": {
              "minItems": 1
            }
          },
          "required": [
            "result_of"
          ]
        }
      }
    }
  ]
}

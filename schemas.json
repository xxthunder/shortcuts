{
  "schemas": [
    {
      "id": "req-implemented",
      "message": "a requirement is implemented by at least one function (SC-073e)",
      "select": {
        "properties": {
          "type": {
            "const": "req"
          }
        }
      },
      "validate": {
        "network_back": {
          "implements": {
            "contains": {
              "local": {
                "properties": {
                  "type": {
                    "const": "impl"
                  }
                }
              }
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "id": "req-tested",
      "message": "a requirement is tested by at least one test (SC-073e)",
      "select": {
        "properties": {
          "type": {
            "const": "req"
          }
        }
      },
      "validate": {
        "network_back": {
          "tests": {
            "contains": {
              "local": {
                "properties": {
                  "type": {
                    "const": "test"
                  }
                }
              }
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "id": "test-title-matchable",
      "message": "a test's title is its Pester path, which its result is matched on: a join splits on commas, and the testrunner turns backslashes in case names into slashes, so the title has neither (SC-073d)",
      "select": {
        "properties": {
          "type": {
            "const": "test"
          }
        }
      },
      "validate": {
        "local": {
          "properties": {
            "title": {
              "pattern": "^[^,\\\\]*$"
            }
          }
        }
      }
    },
    {
      "id": "result-links-its-test",
      "message": "a result from a traced Describe of px-proxy.Tests.ps1 links the test it resulted from; an It renamed without its marker's title breaks the match (SC-073d). The Describes are those SC-073e traced; the rule covers the whole file once every It carries a marker",
      "select": {
        "properties": {
          "type": {
            "const": "testcase"
          },
          "classname": {
            "pattern": "px-proxy\\.Tests\\.ps1$"
          },
          "case_name": {
            "pattern": "^(Get-PxDataDir|Get-PxConfigPath|Get-PxUserConfigPath|Get-KerberosProxyHost|Resolve-PxUpstreamProxy|Remove-PxProxy)\\."
          }
        },
        "required": [
          "classname",
          "case_name"
        ]
      },
      "validate": {
        "local": {
          "properties": {
            "result_of": {
              "minItems": 1
            }
          },
          "required": [
            "result_of"
          ]
        }
      }
    }
  ]
}
